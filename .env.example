# 確認済み: 選択ドメインはPHP 8.3（モジュール版）。RecoCon公開ドメインも別途確認
PHP_VERSION=8.3
# 本番MySQL 8.0.35と同じ8.0系の最終版（8.0.46）。8.0はEOLにつき隔離した開発専用
# 検証が進んだら別のボリュームで mysql:8.4 系も試す
DB_IMAGE=mysql:8.0.46
DB_NAME=recocon_dev
DB_USER=recocon_dev
DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
DB_ROOT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_VALUE
RECOCON_HTTP_PORT=8088
MAILPIT_UI_PORT=8025
# 開発用のメール送信元（Mailpitで受信確認）
RECOCON_MAIL_FROM=recocon-dev@example.com
