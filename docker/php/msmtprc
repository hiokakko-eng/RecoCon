# php-dev.iniは、どのプログラムを実行するかの設定ファイル。
# 対になるmsmtprcは、そのプログラムがどこへメールを送るか。
#
# msmtp自体はサーバーではなくクライアントである。
#
# mail() / mb_send_mail() を Mailpit に受け渡す開発用設定
# 外部SMTPには接続しない

# デフォルトで使う送信設定。
account default

# Docker Compose内のMailpitを指定。
host mailpit

# MailpitのSMTP受信ポート
port 1025

# 外部SMTPサーバーとやり取りしない、Mailpitとの開発用通信前提の設定。
# 外部SMTPサーバーと通信するときはこのまま使わない。
# SMTP認証
auth off
# TLS暗号化
tls off

# SMTP通信で使用する送信元アドレス。「.valid」は、インターネットドメインとして使用できない開発用予約名称。
from recocon-dev@localhost.invalid
